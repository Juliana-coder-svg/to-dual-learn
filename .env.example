# --- Модель. Нужен один из двух ключей. Без них приложение работает в демо-режиме с заглушками.

# Вариант 1: Anthropic напрямую (кэширование промпта, server-side fallback, structured outputs).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Вариант 1а: тот же Anthropic SDK через OpenRouter (у них родной эндпоинт Messages API,
# кэш и structured outputs работают). Ключ OpenRouter кладётся в AUTH_TOKEN, не в API_KEY.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=sk-or-v1-...
# CLAUDE_MODEL=anthropic/claude-opus-5.5

# Вариант 2: OpenAI-совместимый эндпоинт для моделей без Anthropic API: GigaChat, YandexGPT, Qwen/vLLM во внутреннем контуре.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=anthropic/claude-opus-5-5

# Принудительный выбор провайдера: anthropic | openai | demo. По умолчанию — по наличию ключа.
# AI_PROVIDER=

# Цены за миллион токенов (USD) для оценки расхода. По умолчанию — Claude Opus 5.5.
# Курс для показа расхода в рублях (в данных расход хранится в долларах)
# USD_RUB_RATE=90
# AI_PRICE_INPUT_PER_M=4
# AI_PRICE_OUTPUT_PER_M=20

# --- Supabase: база, вход, RLS. Схема — supabase/migrations/0001_init.sql.
# URL и publishable-ключ попадают в клиент, это нормально: доступ ограничивает RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret-ключ (service role) только на сервере: крон писем и тестовые скрипты. В клиент не попадает.
SUPABASE_SERVICE_ROLE_KEY=

# Режим входа. direct (почта и имя, сразу, без письма) работает по умолчанию только на dev-сервере:
# любой, кто знает почту, войдёт под ней. В production по умолчанию magic (ссылка на почту).
# Чтобы включить direct на стенде для показа, задайте ALLOW_DIRECT_LOGIN=1 (решение Юлианы, см. docs/legal/data-map.md 7.5).
# AUTH_LOGIN_MODE=magic принудительно включает ссылку на почту в любом окружении.
# ALLOW_DIRECT_LOGIN=
# AUTH_LOGIN_MODE=

# --- Приложение
# Публичный адрес: ссылка для входа из письма ведёт на <адрес>/auth/callback.
# Должен быть в Redirect URLs проекта Supabase (Authentication → URL Configuration).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Почта: письма «урок дня» и (при self-hosted Supabase) письма со ссылкой для входа.
# Свой SMTP (Unisender Go, Yandex Cloud Postbox, Mailganer и т. п.). Тот же сервер прописывается в GoTrue: GOTRUE_SMTP_*.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=
# Адрес отправителя; домен должен иметь SPF, DKIM и DMARC, иначе письма уйдут в спам.
# MAIL_FROM=To Dual Learn <learn@to-dual.education>
# Запасной канал на время переезда (зарубежный, после переезда убрать):
# RESEND_API_KEY=
# Секрет для cron-маршрута /api/cron/daily. Обязателен: без него маршрут отвечает 401
# и письма не уходят. Vercel подставляет его в заголовок Authorization.
# CRON_SECRET=
