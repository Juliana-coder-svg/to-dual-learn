# Копия в deploy/selectel/.env (в git не попадает). Права: chmod 600.

APP_DOMAIN=learn.example.ru
API_DOMAIN=api.learn.example.ru
# Шлюз и сеть Supabase (проверить командами docker compose ps и docker network ls в /opt/supabase)
SUPABASE_GATEWAY=api-gw:8000
SUPABASE_NETWORK=supabase_default

# Адреса для клиента. NEXT_PUBLIC_* вшиваются при сборке образа.
NEXT_PUBLIC_SITE_URL=https://learn.example.ru
NEXT_PUBLIC_SUPABASE_URL=https://api.learn.example.ru
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Режим входа: magic — ссылка на почту. Не меняйте на direct в продакшене.
AUTH_LOGIN_MODE=magic

# Крон «урок дня»: заголовок Authorization: Bearer <значение>. Длинная случайная строка: openssl rand -hex 32
CRON_SECRET=

# Своя почта
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_REQUIRE_TLS=false  # только для внутреннего релея без STARTTLS
MAIL_FROM=To Dual Learn <learn@example.ru>

# Модель. На этом этапе остаётся OpenRouter.
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=
CLAUDE_MODEL=anthropic/claude-opus-5.5
